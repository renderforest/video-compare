{
  "name": "video-compare",
  "version": "0.1.0",
  "private": true,
  "description": "A/B tool: replay production Renderforest Pro (MiniMax H3) video generations against a new ComfyUI workflow and rate them side by side",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "serve": "node src/server.js",
    "dev": "node --watch src/server.js",
