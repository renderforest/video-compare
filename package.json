    "run": "node src/cli/run.js",
    "export": "node src/cli/export.js",
    "inspect": "node src/cli/inspect.js",
    "test": "node --test"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "csv-parse": "^5.6.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "ws": "^8.18.0"
  }
}
