# ComfyUI base URL (same machine). gen22 runs it on 8188.
COMFY_URL=http://127.0.0.1:8188
# Admin site port, bound to 0.0.0.0 so the link works for everyone
PORT=3001
HOST=0.0.0.0
# Per-generation timeout (MiniMax 720p clips of 11-15 s take up to ~20 min in production)
JOB_TIMEOUT_MS=1800000
# Public base URL used in exported CSVs for local video links (optional; defaults to http://<host>:<port>)
PUBLIC_BASE_URL=http://69.197.165.120:3001
# Pause generation when the data disk has less than this many GB free (default 30)
MIN_FREE_DISK_GB=30
# ComfyUI output folder on this machine; our clips are deleted there after download to save space
COMFY_OUTPUT_DIR=/workspace/comfyui/ComfyUI/output
